<Window x:Class="TeamsVoiceWizard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
        Title="Teams Voice Wizard">

    <TabView x:Name="MainTabView"
             IsAddTabButtonVisible="False"
             TabWidthMode="Equal"
             Margin="0">

        <!-- ── Tab 1: Configuration ── -->
        <TabViewItem Header="Configuration" IsClosable="False">
            <Grid x:Name="RootGrid" Margin="12" RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="120" />
                    <RowDefinition Height="200" />
                </Grid.RowDefinitions>

                <!-- ROW 0 -->
                <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,10">

                    <TextBlock Text="PSTN Gateway(s) — Gamma shorthand or full FQDNs, comma-separated"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBox x:Name="GammaBox"
                             PlaceholderText="e.g. acme01  or  acme01.part03.ucconnect.co.uk, acme01.part13.ucconnect.co.uk"
                             TextChanged="GammaBox_TextChanged" />

                    <CheckBox x:Name="ChkDerivedTrunk"
                              Content="Use derived trunk model (Gamma / Operator-managed)"
                              IsChecked="True"
                              Checked="ChkDerivedTrunk_Checked"
                              Unchecked="ChkDerivedTrunk_Unchecked" />

                    <TextBlock Text="Site Name"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBox x:Name="SiteBox"
                             PlaceholderText="e.g. London-HQ"
                             TextChanged="SiteBox_TextChanged" />

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Country (ISO 3166-1 alpha-2)"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBox x:Name="CountryBox"
                                 Text="GB"
                                 Width="90"
                                 MaxLength="2"
                                 TextChanged="CountryBox_TextChanged" />
                    </StackPanel>

                    <!-- Workflow steps grid -->
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Step 1: Authentication -->
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="1. Auth"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                        <StackPanel Grid.Row="0" Grid.Column="1"
                                    Orientation="Horizontal" Spacing="8">
                            <Button x:Name="BtnConnectGraph"
                                    Content="Connect Graph"
                                    Click="BtnConnectGraph_Click" />
                            <Button x:Name="BtnConnectTeams"
                                    Content="Connect Teams"
                                    IsEnabled="False"
                                    Click="BtnConnectTeams_Click" />
                        </StackPanel>

                        <!-- Step 2: Domains -->
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="2. Domains"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                        <StackPanel Grid.Row="1" Grid.Column="1"
                                    Orientation="Horizontal" Spacing="8">
                            <Button x:Name="BtnDomainsTxt"
                                    Content="Create Domains + Get TXT"
                                    IsEnabled="False"
                                    Click="BtnDomainsTxt_Click" />
                            <Button x:Name="BtnVerify"
                                    Content="Verify Domains"
                                    IsEnabled="False"
                                    Click="BtnVerify_Click" />
                        </StackPanel>

                        <!-- Step 3: Test objects -->
                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="3. Test Objects"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                        <Grid Grid.Row="2" Grid.Column="1" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    x:Name="BtnLoadSkus"
                                    Content="Load Licence SKUs"
                                    IsEnabled="False"
                                    Click="BtnLoadSkus_Click" />
                            <ComboBox Grid.Column="1"
                                      x:Name="SkuDrop"
                                      HorizontalAlignment="Stretch"
                                      PlaceholderText="Select a SKU for test objects"
                                      SelectionChanged="SkuDrop_SelectionChanged" />
                            <Button Grid.Column="2"
                                    x:Name="BtnCreateTestObjs"
                                    Content="Create Test Objects + Assign Licence"
                                    IsEnabled="False"
                                    Click="BtnCreateTestObjs_Click" />
                            <Button Grid.Column="3"
                                    x:Name="BtnCleanup"
                                    Content="Cleanup Test Objects"
                                    IsEnabled="False"
                                    Click="BtnCleanup_Click" />
                        </Grid>

                        <!-- Step 4: Apply voice config -->
                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   Text="4. Configure"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                        <Button Grid.Row="3" Grid.Column="1"
                                x:Name="BtnApplyVoice"
                                Content="⚙ Apply Voice Configuration"
                                IsEnabled="False"
                                Click="BtnApplyVoice_Click" />
                    </Grid>

                    <!-- Status / busy indicator -->
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                x:Name="StatusPanel" Visibility="Collapsed">
                        <ProgressRing x:Name="BusyRing"
                                      IsActive="False"
                                      Width="18" Height="18"
                                      VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                    </StackPanel>

                </StackPanel>

                <!-- ROW 1 — Output -->
                <Border Grid.Row="1"
                        BorderBrush="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                        BorderThickness="1" Padding="6" Margin="0,0,0,6">
                    <ScrollViewer x:Name="OutputScroll"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="OutputBox"
                                 IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="NoWrap" FontFamily="Consolas"
                                 FontSize="12" Background="Transparent"
                                 BorderThickness="0" />
                    </ScrollViewer>
                </Border>

                <!-- ROW 2 — Log -->
                <Border Grid.Row="2"
                        BorderBrush="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                        BorderThickness="1" Padding="6">
                    <ScrollViewer x:Name="LogScroll"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="LogBox"
                                 IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="Wrap" FontSize="11"
                                 Background="Transparent" BorderThickness="0" />
                    </ScrollViewer>
                </Border>

            </Grid>
        </TabViewItem>

        <!-- ── Tab 2: Phone Management ── -->
        <TabViewItem x:Name="PhoneTab"
                     Header="Phone Management"
                     IsClosable="False"
                     IsEnabled="False">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <StackPanel Grid.Row="0" Orientation="Horizontal"
                            Spacing="8" Margin="0,0,0,8">
                    <Button x:Name="BtnLoadNumbers"
                            Content="Load Numbers"
                            Click="BtnLoadNumbers_Click" />
                    <Button x:Name="BtnApplyChanges"
                            Content="Apply Changes"
                            IsEnabled="False"
                            Click="BtnApplyChanges_Click" />
                    <ProgressRing x:Name="PhoneBusyRing"
                                  IsActive="False" Width="18" Height="18"
                                  VerticalAlignment="Center" />
                    <TextBlock x:Name="PhoneStatusText"
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                </StackPanel>

                <!-- DataGrid + Side Panel -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- DataGrid -->
                    <controls:DataGrid Grid.Column="0"
                                       x:Name="NumbersGrid"
                                       AutoGenerateColumns="False"
                                       SelectionMode="Single"
                                       CanUserSortColumns="True"
                                       IsReadOnly="True"
                                       GridLinesVisibility="Horizontal"
                                       SelectionChanged="NumbersGrid_SelectionChanged">
                        <controls:DataGrid.Columns>
                            <controls:DataGridTextColumn Header="Phone Number"
                                                         Binding="{Binding TelephoneNumber}"
                                                         Width="160" />
                            <controls:DataGridTextColumn Header="Type"
                                                         Binding="{Binding NumberType}"
                                                         Width="140" />
                            <controls:DataGridTextColumn Header="Assigned To"
                                                         Binding="{Binding AssignedUserDisplayName}"
                                                         Width="220" />
                            <controls:DataGridTextColumn Header="Status"
                                                         Binding="{Binding AssignmentStatus}"
                                                         Width="200" />
                        </controls:DataGrid.Columns>
                    </controls:DataGrid>

                    <!-- Side Panel -->
                    <Border Grid.Column="1"
                            x:Name="SidePanel"
                            Visibility="Collapsed"
                            Width="320"
                            BorderThickness="1,0,0,0"
                            BorderBrush="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                            Padding="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="16">
                                <!-- === SECTION A: Number Info (Always visible when panel open) === -->
                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="Phone Number Details"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource BaseTextBlockStyle}" />
                                        <Button x:Name="BtnCloseSidePanel"
                                                Grid.Column="1"
                                                AutomationProperties.Name="Close details panel"
                                                ToolTipService.ToolTip="Close"
                                                Click="BtnCloseSidePanel_Click"
                                                Padding="8,4"
                                                MinWidth="32"
                                                Style="{StaticResource SubtleButtonStyle}">
                                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                      Glyph="&#xE711;"
                                                      FontSize="14" />
                                        </Button>
                                    </Grid>

                                    <Grid RowSpacing="6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="Number:"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1"
                               x:Name="TxtPhoneNumber"
                               Text=""
                               Style="{StaticResource CaptionTextBlockStyle}"
                               FontFamily="Consolas" />

                                        <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="Type:"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1"
                               x:Name="TxtNumberType"
                               Text=""
                               Style="{StaticResource CaptionTextBlockStyle}" />

                                        <TextBlock Grid.Row="2" Grid.Column="0"
                               Text="Status:"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1"
                               x:Name="TxtStatus"
                               Text=""
                               Style="{StaticResource CaptionTextBlockStyle}" />

                                        <TextBlock Grid.Row="3" Grid.Column="0"
                               Text="Current User:"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                                        <TextBlock Grid.Row="3" Grid.Column="1"
                               x:Name="TxtCurrentUser"
                               Text="(unassigned)"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                                    </Grid>
                                </StackPanel>

                                <!-- Divider -->
                                <Border Height="1"
                    Background="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                    Opacity="0.3" />

                                <!-- === SECTION B: User Assignment === -->
                                <StackPanel x:Name="UserAssignmentSection"
                                            Spacing="8"
                                            Visibility="Visible">
                                    <TextBlock Text="Assign User"
                                               FontWeight="SemiBold"
                                               Style="{StaticResource BaseTextBlockStyle}" />

                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="Teams Phone User:"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource CaptionTextBlockStyle}" />
                                            <ProgressRing x:Name="UserLoadingRing"
                                                          IsActive="False"
                                                          Width="14"
                                                          Height="14"
                                                          VerticalAlignment="Center" />
                                        </StackPanel>

                                        <ComboBox x:Name="UserComboBox"
                                                  HorizontalAlignment="Stretch"
                                                  PlaceholderText="Select a user"
                                                  DropDownOpened="UserComboBox_DropDownOpened"
                                                  SelectionChanged="UserComboBox_SelectionChanged" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Divider -->
                                <Border Height="1"
                                        Background="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                        Opacity="0.3" />

                                <!-- === SECTION C: Policy Assignment (visible only for Direct Routing + assigned) === -->
                                <StackPanel x:Name="PolicyAssignmentSection"
                                            Spacing="8"
                                            Visibility="Collapsed">
                                    <TextBlock Text="Direct Routing Policies"
                                               FontWeight="SemiBold"
                                               Style="{StaticResource BaseTextBlockStyle}" />

                                    <!-- Dial Plan -->
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="Dial Plan:"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource CaptionTextBlockStyle}" />
                                            <ProgressRing x:Name="DialPlanLoadingRing"
                                                          IsActive="False"
                                                          Width="14" Height="14"
                                                          VerticalAlignment="Center" />
                                        </StackPanel>

                                        <ComboBox x:Name="DialPlanComboBox"
                                                  HorizontalAlignment="Stretch"
                                                  PlaceholderText="None"
                                                  DropDownOpened="DialPlanComboBox_DropDownOpened"
                                                  SelectionChanged="DialPlanComboBox_SelectionChanged" />

                                        <TextBlock x:Name="DialPlanNote"
                                                   Text="Leave blank to keep current assignment"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                                   FontSize="10"
                                                   Visibility="Collapsed" />
                                    </StackPanel>

                                    <!-- Voice Routing Policy -->
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="Voice Routing Policy:"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource CaptionTextBlockStyle}" />
                                            <ProgressRing x:Name="VRPolicyLoadingRing"
                                                          IsActive="False"
                                                          Width="14" Height="14"
                                                          VerticalAlignment="Center" />
                                        </StackPanel>

                                        <ComboBox x:Name="VoiceRoutingPolicyComboBox"
                                                  HorizontalAlignment="Stretch"
                                                  PlaceholderText="None"
                                                  DropDownOpened="VoiceRoutingPolicyComboBox_DropDownOpened"
                                                  SelectionChanged="VoiceRoutingPolicyComboBox_SelectionChanged" />

                                        <TextBlock x:Name="VRPolicyNote"
                                                   Text="Leave blank to keep current assignment"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                                   FontSize="10"
                                                   Visibility="Collapsed" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Divider -->
                                <Border Height="1"
                    Background="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                    Opacity="0.3" />

                                <!-- === Apply Button === -->
                                <Button x:Name="BtnApplySingleNumber"
                    Content="Apply Changes"
                    HorizontalAlignment="Stretch"
                    IsEnabled="False"
                    Click="BtnApplySingleNumber_Click"
                    Style="{StaticResource AccentButtonStyle}" />

                                <!-- Status message -->
                                <TextBlock x:Name="SidePanelStatusText"
                       Text=""
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                </Grid>
            </Grid>
        </TabViewItem>

    </TabView>
</Window>