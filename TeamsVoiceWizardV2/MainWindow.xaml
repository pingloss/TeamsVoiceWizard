<Window x:Class="TeamsVoiceWizardV2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:TeamsVoiceWizardV2.Views"
        Title="Teams Voice Wizard">

    <TabView x:Name="MainTabView"
             IsAddTabButtonVisible="False"
             TabWidthMode="Equal"
             Margin="0">

        <!-- ── Tab 1: Configuration ── -->
        <TabViewItem Header="Configuration" IsClosable="False">
            <views:ConfigurationView x:Name="ConfigurationHost" />
        </TabViewItem>

        <!-- ── Tab 2: Phone Management ── -->
        <TabViewItem x:Name="PhoneTab"
                     Header="Phone Management"
                     IsClosable="False"
                     IsEnabled="False">
            <views:PhoneManagementView x:Name="PhoneManagementHost" />
        </TabViewItem>

    </TabView>
</Window>
