<ContentDialog x:Class="TeamsVoiceWizardV2.Views.BulkImportDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
               xmlns:tw="using:TeamsVoiceWizardV2"
               Title="Bulk User Import"
               PrimaryButtonText="Apply Import"
               CloseButtonText="Close"
               DefaultButton="Close">

    <ContentDialog.Resources>
        <tw:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </ContentDialog.Resources>

    <Grid MinHeight="520" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── Row 0: File picker ── -->
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,12">
            <TextBlock Text="Select a CSV or XLSX file to import. Required columns: PhoneNumber, UserPrincipalName. For Direct Routing numbers, DialPlan and VoiceRoutingPolicy are also required."
                       TextWrapping="Wrap"
                       HorizontalAlignment="Stretch"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="BrowseButton"
                        Content="Browse…"
                        Click="BrowseButton_Click" />
                <TextBlock x:Name="FileNameText"
                           Text="{Binding FileName}"
                           VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}" />
                <ProgressRing IsActive="{Binding IsLoading}"
                              Width="16" Height="16"
                              VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <!-- ── Row 1: Toolbar (Validate + Cancel) ── -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Button Content="Validate"
                    Command="{Binding ValidateCommand}"
                    IsEnabled="{Binding CanValidate}" />
            <Button Content="Cancel Operation"
                    Command="{Binding CancelCommand}"
                    Visibility="{Binding IsValidating, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="Cancel Operation"
                    Command="{Binding CancelCommand}"
                    Visibility="{Binding IsApplying, Converter={StaticResource BoolToVisibility}}" />
            <ProgressRing IsActive="{Binding IsValidating}"
                          Width="16" Height="16"
                          VerticalAlignment="Center" />
            <ProgressRing IsActive="{Binding IsApplying}"
                          Width="16" Height="16"
                          VerticalAlignment="Center" />
            <TextBlock Text="{Binding ProgressMessage}"
                       VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
        </StackPanel>

        <!-- ── Row 2: Preview / results DataGrid ── -->
        <Border Grid.Row="2"
                BorderBrush="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                BorderThickness="1"
                Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}">
            <controls:DataGrid x:Name="ImportGrid"
                               AutoGenerateColumns="False"
                               SelectionMode="Single"
                               CanUserSortColumns="False"
                               IsReadOnly="True"
                               GridLinesVisibility="Horizontal"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch"
                               ItemsSource="{Binding Rows}">
                <controls:DataGrid.Columns>
                    <controls:DataGridTextColumn Header="Row"
                                                 Binding="{Binding RowNumber}"
                                                 Width="45" />
                    <controls:DataGridTextColumn Header="Phone Number"
                                                 Binding="{Binding PhoneNumber}"
                                                 Width="155" />
                    <controls:DataGridTextColumn Header="User (UPN)"
                                                 Binding="{Binding UserPrincipalName}"
                                                 Width="220" />
                    <controls:DataGridTextColumn Header="Dial Plan"
                                                 Binding="{Binding DialPlan}"
                                                 Width="130" />
                    <controls:DataGridTextColumn Header="Voice Routing Policy"
                                                 Binding="{Binding VoiceRoutingPolicy}"
                                                 Width="150" />
                    <controls:DataGridTextColumn Header="Status"
                                                 Binding="{Binding StatusText}"
                                                 Width="90" />
                    <controls:DataGridTextColumn Header="Details"
                                                 Binding="{Binding ValidationMessage}"
                                                 Width="*" />
                </controls:DataGrid.Columns>
            </controls:DataGrid>
        </Border>

        <TextBlock Grid.Row="2"
                   x:Name="EmptyPlaceholder"
                   Text="No file loaded. Click 'Browse…' to select a CSV or XLSX file."
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                   Visibility="Collapsed" />

        <!-- ── Row 3: Status summary ── -->
        <TextBlock Grid.Row="3"
                   Text="{Binding StatusSummary}"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Style="{StaticResource CaptionTextBlockStyle}" />
    </Grid>
</ContentDialog>
