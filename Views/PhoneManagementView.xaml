<UserControl x:Class="TeamsVoiceWizard.Views.PhoneManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
             xmlns:vm="using:TeamsVoiceWizard.ViewModels"
             xmlns:tw="using:TeamsVoiceWizard"
             x:DataType="vm:PhoneManagementViewModel">

    <UserControl.Resources>
        <tw:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <Grid x:Name="RootGrid"
          Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal"
                    Spacing="8" Margin="0,0,0,8">
            <Button Content="Load Numbers"
                    Command="{x:Bind LoadNumbersCommand}"
                    IsEnabled="{x:Bind IsLoadNumbersEnabled, Mode=OneWay}" />
            <Button Content="Apply Changes"
                    Command="{x:Bind ApplyBatchChangesCommand}" />
            <ProgressRing IsActive="{x:Bind IsPhoneBusy, Mode=OneWay}"
                          Width="18" Height="18"
                          VerticalAlignment="Center" />
            <TextBlock VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                       Text="{x:Bind PhoneStatusMessage, Mode=OneWay}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <controls:DataGrid x:Name="NumbersGrid"
                               Grid.Column="0"
                               AutoGenerateColumns="False"
                               SelectionMode="Single"
                               CanUserSortColumns="True"
                               IsReadOnly="True"
                               GridLinesVisibility="Horizontal"
                               ItemsSource="{x:Bind PhoneRecords, Mode=OneWay}"
                               SelectedItem="{x:Bind SelectedRecord, Mode=TwoWay}">
                <controls:DataGrid.Columns>
                    <controls:DataGridTextColumn Header="Phone Number"
                                                 Binding="{Binding TelephoneNumber}"
                                                 Width="160" />
                    <controls:DataGridTextColumn Header="Type"
                                                 Binding="{Binding NumberType}"
                                                 Width="140" />
                    <controls:DataGridTextColumn Header="Assigned To"
                                                 Binding="{Binding AssignedUserDisplayName}"
                                                 Width="220" />
                    <controls:DataGridTextColumn Header="Status"
                                                 Binding="{Binding AssignmentStatus}"
                                                 Width="200" />
                </controls:DataGrid.Columns>
            </controls:DataGrid>

            <Border Grid.Column="1"
                    Width="320"
                    BorderThickness="1,0,0,0"
                    BorderBrush="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                    Padding="12"
                    Visibility="{x:Bind IsSidePanelVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Phone Number Details"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource BaseTextBlockStyle}" />
                                <Button Grid.Column="1"
                                        AutomationProperties.Name="Close details panel"
                                        ToolTipService.ToolTip="Close"
                                        Command="{x:Bind CloseSidePanelCommand}"
                                        Padding="8,4"
                                        MinWidth="32"
                                        Style="{StaticResource SubtleButtonStyle}">
                                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                              Glyph="&#xE711;"
                                              FontSize="14" />
                                </Button>
                            </Grid>

                            <Grid RowSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="Number:"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{x:Bind DetailPhoneNumber, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           FontFamily="Consolas" />

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="Type:"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="{x:Bind DetailNumberType, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}" />

                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Text="Status:"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                                <TextBlock Grid.Row="2" Grid.Column="1"
                                           Text="{x:Bind DetailStatus, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}" />

                                <TextBlock Grid.Row="3" Grid.Column="0"
                                           Text="Current User:"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                                <TextBlock Grid.Row="3" Grid.Column="1"
                                           Text="{x:Bind DetailCurrentUser, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </Grid>
                        </StackPanel>

                        <Border Height="1"
                                Background="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                Opacity="0.3" />

                        <StackPanel Spacing="8" Visibility="Visible">
                            <TextBlock Text="Assign User"
                                       FontWeight="SemiBold"
                                       Style="{StaticResource BaseTextBlockStyle}" />

                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Teams Phone User:"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                    <ProgressRing IsActive="{x:Bind UserLoadingRingActive, Mode=OneWay}"
                                                  Width="14"
                                                  Height="14"
                                                  VerticalAlignment="Center" />
                                </StackPanel>

                                <ComboBox HorizontalAlignment="Stretch"
                                          PlaceholderText="Select a user"
                                          ItemsSource="{x:Bind UserOptions, Mode=OneWay}"
                                          DisplayMemberPath="Label"
                                          SelectedItem="{x:Bind SelectedUserItem, Mode=TwoWay}"
                                          DropDownOpened="UserComboBox_DropDownOpened" />
                            </StackPanel>
                        </StackPanel>

                        <Border Height="1"
                                Background="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                Opacity="0.3" />

                        <StackPanel Spacing="8"
                                    Visibility="{x:Bind IsPolicySectionVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Direct Routing Policies"
                                       FontWeight="SemiBold"
                                       Style="{StaticResource BaseTextBlockStyle}" />

                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Dial Plan:"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                    <ProgressRing IsActive="{x:Bind DialPlanLoadingRingActive, Mode=OneWay}"
                                                  Width="14" Height="14"
                                                  VerticalAlignment="Center" />
                                </StackPanel>

                                <ComboBox HorizontalAlignment="Stretch"
                                          PlaceholderText="None"
                                          ItemsSource="{x:Bind DialPlanOptions, Mode=OneWay}"
                                          DisplayMemberPath="Label"
                                          SelectedItem="{x:Bind SelectedDialPlanItem, Mode=TwoWay}"
                                          DropDownOpened="DialPlanComboBox_DropDownOpened" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Voice Routing Policy:"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                    <ProgressRing IsActive="{x:Bind VRPolicyLoadingRingActive, Mode=OneWay}"
                                                  Width="14" Height="14"
                                                  VerticalAlignment="Center" />
                                </StackPanel>

                                <ComboBox HorizontalAlignment="Stretch"
                                          PlaceholderText="None"
                                          ItemsSource="{x:Bind VoiceRoutingOptions, Mode=OneWay}"
                                          DisplayMemberPath="Label"
                                          SelectedItem="{x:Bind SelectedVoiceRoutingItem, Mode=TwoWay}"
                                          DropDownOpened="VoiceRoutingPolicyComboBox_DropDownOpened" />
                            </StackPanel>
                        </StackPanel>

                        <Border Height="1"
                                Background="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                Opacity="0.3" />

                        <Button Content="Apply Changes"
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ApplySingleChangeCommand}"
                                Style="{StaticResource AccentButtonStyle}" />

                        <TextBlock Text="{x:Bind SidePanelStatusText, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{x:Bind SidePanelStatusBrush, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Visibility="{x:Bind SidePanelStatusVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
